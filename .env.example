# Alert delivery settings. Copy this file to .env and fill in your values.
# Never commit .env to version control. Template values below are ignored.

# Email (SMTP). For Gmail use an App Password, not your account password.
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password
RECIPIENT_EMAIL=alert-recipient@example.com

# Optional: AWS SNS topic (pip install -r requirements-aws.txt)
# ALERT_SNS_TOPIC_ARN=arn:aws:sns:eu-central-1:123456789012:service-watchdog-alerts
